# godocs Frontend Configuration
# =============================================================================
# This file is for STANDALONE FRONTEND deployments only.
# If running the standard godocs binary (backend + frontend together),
# use .env instead - the frontend settings are in the "Frontend" section.
#
# Copy this to frontend.env and customize for your environment.
#
# Usage: go run ./cmd/frontend
# =============================================================================

# Frontend Server Address
# The hostname/IP for the frontend server (default: localhost)
FRONTEND_ADDR=localhost

# Frontend Server Port
# The port this frontend server will listen on (default: 8001)
FRONTEND_PORT=8001

# Backend API URL
# The URL where the backend API is running. The frontend WASM app will
# send all API requests to this URL, and resources (WASM, CSS) are loaded from here.
# Examples:
#   - Local development: http://localhost:8000
#   - Same server different port: http://192.168.1.100:8000
#   - Production: https://api.yourdomain.com
SERVER_API_URL=http://localhost:8000

# Frontend Display Settings
# Number of recent/new documents to show on the home page
NEW_DOCUMENT_COUNT=5

# =============================================================================
# Logging
# =============================================================================

# Log level: debug, info, warn, error
LOG_LEVEL=info

# Log output: stdout or file
LOG_OUTPUT=stdout

# Log file location (only used if LOG_OUTPUT=file)
# LOG_FILE=frontend.log
