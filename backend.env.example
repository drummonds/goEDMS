# godocs Backend Configuration
# =============================================================================
# This file shows all backend-specific settings.
# Copy to .env in the project root and customize for your environment.
# =============================================================================

# Server Configuration
# The server serves both the API and the frontend WASM application
SERVER_PORT=8000
SERVER_ADDR=  # Leave empty to bind to all interfaces, or specify IP (e.g., 127.0.0.1)

# Database Configuration
DATABASE_TYPE=postgres
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_USER=godocs
DATABASE_PASSWORD=postgres
DATABASE_NAME=godocs

# Document Storage
INGRESS_PATH=./ingress
INGRESS_INTERVAL=10  # Minutes between ingress scans
INGRESS_DELETE=true  # Delete source files after ingestion
INGRESS_PRESERVE_STRUCTURE=true  # Preserve folder structure from ingress
DOCUMENT_PATH=./documents
NEW_DOCUMENT_FOLDER=New

# OCR Configuration
TESSERACT_PATH=/usr/bin/tesseract

# Reverse Proxy (if using nginx/apache in front)
PROXY_ENABLED=false
BASE_URL=https://godocs.yourdomain.com

# Authentication (optional)
WEB_UI_AUTH=false
WEB_UI_USER=admin
WEB_UI_PASSWORD=Password1

# Notifications (optional)
PUSHBULLET_TOKEN=

# Frontend Settings
# These affect the WASM frontend served by this server
NEW_DOCUMENT_COUNT=5  # Number of recent documents on home page

# Logging
LOG_LEVEL=debug  # debug, info, warn, error
LOG_OUTPUT=file  # file or stdout
LOG_FILE=godocs.log
